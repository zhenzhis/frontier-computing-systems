{
  "debugLog": false,
  "permissionReviewLog": false,
  "yoloMode": false,
  "piInfrastructureReadPaths": [
    "~/.pi/agent",
    "~/.pi/agent/*",
    "~/AppData/Roaming/npm/node_modules/@earendil-works",
    "~/AppData/Roaming/npm/node_modules/@earendil-works/*"
  ],
  "permission": {
    "*": "allow",
    "path": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "~/.ssh/*": "deny",
      "$HOME/.ssh/*": "deny",
      "~/.pi/agent/auth.json": "deny",
      "~/.pi/agent/models.json": "deny",
      "~/.codex/auth.json": "deny",
      "*\\users\\*\\.pi\\agent\\auth.json": "deny",
      "*\\users\\*\\.pi\\agent\\models.json": "deny",
      "~/.pi/agent/mcp-auth.json": "deny",
      "~/.pi/agent/models-store.json": "deny"
    },
    "external_directory": {
      "*": "ask",
      "*\\users\\*\\.pi\\agent\\skills\\*": "allow",
      "*\\users\\*\\.pi\\agent\\npm\\*": "allow",
      "*\\users\\*\\.pi\\agent\\sessions\\*": "allow",
      "*\\users\\*\\.pi\\agent\\repos\\*": "allow",
      "*\\node_modules\\@earendil-works\\*": "allow",
      "*\\node_modules\\@earendil-works": "allow",
      "*\\dev\\null\\*": "allow",
      "*\\dev\\null*": "allow",
      "*\\dev\\null\\": "allow",
      "*\\dev\\null": "allow"
    },
    "bash": {
      "*": "allow",
      "Remove-Item *": "ask",
      "remove-item *": "ask",
      "rm *": "ask",
      "del *": "ask",
      "erase *": "ask",
      "rd *": "ask",
      "rmdir *": "ask",
      "ri *": "ask",
      "mv *": "ask",
      "cmd /c del *": "ask",
      "cmd /c erase *": "ask",
      "cmd /c rd *": "ask",
      "cmd /c rmdir *": "ask",
      "cmd.exe /c del *": "ask",
      "cmd.exe /c erase *": "ask",
      "cmd.exe /c rd *": "ask",
      "cmd.exe /c rmdir *": "ask",
      "powershell *Remove-Item*": "ask",
      "powershell.exe *Remove-Item*": "ask",
      "pwsh *Remove-Item*": "ask",
      "pwsh.exe *Remove-Item*": "ask",
      "git clean *": "ask",
      "git reset --hard": "ask",
      "git reset --hard *": "ask",
      "git * reset *": "ask",
      "git * clean *": "ask",
      "git * push *": "ask",
      "git * restore *": "ask",
      "git * checkout *": "ask",
      "git.exe *reset *": "ask",
      "git.exe *clean *": "ask",
      "git.exe *push *": "ask",
      "git.exe *restore *": "ask",
      "git.exe *checkout *": "ask",
      "*\\git.exe *reset *": "ask",
      "*\\git.exe *clean *": "ask",
      "*\\git.exe *push *": "ask",
      "*\\git.exe *restore *": "ask",
      "*\\git.exe *checkout *": "ask",
      "*\\Remove-Item *": "ask",
      "*\\Set-Content *": "ask",
      "*\\Move-Item *": "ask",
      "*\\Rename-Item *": "ask",
      "*\\Clear-Content *": "ask",
      "*\\Out-File *": "ask",
      "git push *": "ask",
      "npm publish*": "ask",
      "git checkout -- *": "ask",
      "git restore *": "ask",
      "Clear-Content *": "ask",
      "Set-Content *": "ask",
      "Out-File *": "ask",
      "Move-Item *": "ask",
      "Rename-Item *": "ask"
    },
    "grep": "allow",
    "find": "allow"
  },
  "shellTools": {
    "powershell": {
      "commandArgument": "command"
    }
  }
}
