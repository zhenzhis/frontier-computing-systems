{
  "name": "zhenzhi-workflow",
  "version": "0.1.0",
  "description": "Versioned, reversible Pi workflows for deliberate agent engineering on Windows.",
  "license": "MIT",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24.12.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/zhenzhis/zhenzhi-workflow.git"
  },
  "scripts": {
    "test": "node --test runtime/*.test.mjs tests/*.test.mjs",
    "audit": "node scripts/audit-public.mjs",
    "verify": "npm run audit && node scripts/verify-links.mjs && npm test && node scripts/verify-manifest.mjs",
    "verify:sdk": "node scripts/verify-sdk.mjs",
    "backup": "node scripts/backup.mjs",
    "release:plan": "node scripts/release.mjs"
  },
  "dependencies": {
    "@gotgenes/pi-permission-system": "40.1.3"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.2.0",
    "@earendil-works/pi-tui": "1.2.0"
  },
  "pi": {
    "extensions": [
      "managed/extensions/workflow-baseline/index.ts",
      "managed/extensions/workflow-runtime/index.ts"
    ],
    "prompts": [
      "managed/prompts"
    ],
    "skills": [
      "managed/skills"
    ],
    "themes": [
      "managed/themes"
    ]
  },
  "files": [
    "managed/",
    "runtime/",
    "templates/",
    "docs/",
    "licenses/",
    "NOTICE",
    "LICENSE",
    "README.md",
    "scripts/verify-manifest.mjs",
    "release-manifest.json"
  ]
}
